  "item": [
    {
      "name": "Locations",
      "item": [
        {
          "name": "Create Location A (sets locationId1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const json = pm.response.json();",
                  "pm.test('ok=true', () => pm.expect(json.ok).to.eql(true));",
                  "if (json?.data?.id) pm.collectionVariables.set('locationId1', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Location A\",\n  \"description\": \"Test location A\",\n  \"location\": { \"type\": \"Point\", \"coordinates\": [22.2895, 48.6217] },\n  \"address\": \"Uzhhorod, Test street 1\",\n  \"priceLevel\": 2,\n  \"imagesLinks\": [\"https://example.com/a.jpg\"],\n  \"avgStayMinutes\": 60,\n  \"avgTastingPricePerPerson\": 15,\n  \"avgMealPricePerPerson\": 25,\n  \"avgBottlePrice\": 18,\n  \"siteUrl\": \"https://example.com\",\n  \"contactNumber\": \"+380000000000\",\n  \"wineTags\": [\"RED\", \"WHITE\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/locations",
              "host": ["{{baseUrl}}"],
              "path": ["locations"]
            }
          }
        },
        {
          "name": "Create Location B (sets locationId2)",
