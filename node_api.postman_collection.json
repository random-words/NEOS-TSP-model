              "mode": "raw",
              "raw": "{\n  \"name\": \"Location B\",\n  \"description\": \"Test location B\",\n  \"location\": { \"type\": \"Point\", \"coordinates\": [22.3000, 48.6300] },\n  \"address\": \"Uzhhorod, Test street 2\",\n  \"priceLevel\": 3,\n  \"imagesLinks\": [\"https://example.com/b.jpg\"],\n  \"avgStayMinutes\": 45,\n  \"avgTastingPricePerPerson\": 20,\n  \"avgMealPricePerPerson\": 30,\n  \"avgBottlePrice\": 22,\n  \"siteUrl\": \"https://example.com\",\n  \"contactNumber\": \"+380000000001\",\n  \"wineTags\": [\"SPARKLING\"]\n}"
